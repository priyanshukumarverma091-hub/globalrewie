# Copy to .env for local development. NEVER commit .env.
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Leave empty to use local SQLite. For PostgreSQL / Neon:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/globalreview?sslmode=require
DATABASE_URL=
SITE_URL=http://127.0.0.1:5000
CONTACT_EMAIL=editor@example.com

# First admin (used by `flask create-admin --from-env`). Remove ADMIN_PASSWORD after first login.
ADMIN_EMAIL=
ADMIN_NAME=Chief Editor
ADMIN_PASSWORD=

# Optional news integrations
NEWSAPI_KEY=
FETCH_CACHE_MINUTES=30
# Enables POST /tasks/fetch-news for free external schedulers. Leave empty to disable.
CRON_TOKEN=

# Where uploaded images are stored (persistent disk path in production)
UPLOAD_DIR=
RATELIMIT_STORAGE_URI=memory://
